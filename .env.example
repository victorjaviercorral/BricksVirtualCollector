# ---------------------------------------------------------------------------
# BricksVirtualCollector — variables de entorno
#
# Copia este fichero a `.env.local` y rellena los valores de tu proyecto.
# `.env*` está en .gitignore: nunca subas el fichero real al repositorio.
# ---------------------------------------------------------------------------

# URL del proyecto de Supabase.
# Panel de Supabase > Project Settings > API > Project URL
# Se expone al navegador (prefijo NEXT_PUBLIC_): es información pública por diseño.
NEXT_PUBLIC_SUPABASE_URL="https://<tu-proyecto>.supabase.co"

# Clave anónima de Supabase.
# Panel de Supabase > Project Settings > API > Project API keys > anon / public
# También viaja al navegador. NO es un secreto: la seguridad la garantiza RLS
# (Row Level Security), no el ocultamiento de esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<tu-anon-key>"

# Clave de servicio de Supabase. ESTA SÍ ES UN SECRETO.
# Panel de Supabase > Project Settings > API > Project API keys > service_role
# Salta todas las políticas RLS. Solo se usa en servidor:
#   - src/lib/logger.ts                          (escritura en la tabla system_logs)
#   - src/app/api/auth/delete-account/route.ts   (borrado de cuenta, derecho de supresión RGPD)
#   - src/app/api/sets/foto/route.ts             (subida de fotos de set; el bucket fotos_sets
#                                                  no acepta INSERT directo del cliente desde la
#                                                  migración 20260901100000, ADR-005)
#   - src/app/api/bounties/claim/route.ts        (bricks de recompensa al reclamar un bounty)
# Sin esta variable: el borrado de cuenta y la subida de fotos de set devuelven 500 con un
# mensaje explícito ("...no está configurado correctamente..."); logger.ts y el reparto de
# recompensas de bounties degradan sin fallar (sin registrar/conceder, pero sin romper la request).
SUPABASE_SERVICE_ROLE_KEY="<tu-service-role-key>"
